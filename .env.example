# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible). Server-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tijori-media
# Optional: only needed if you put a public custom domain in front of the bucket.
# Leave empty to serve media through the app's own signed-URL route instead.
R2_PUBLIC_URL=
